# #################################
# Auto Completions                #
# #################################

{{ if and (eq .chezmoi.os "darwin") (ge (int (dig "machine" "memoryGb" 0 .)) 128) -}}
# oMLX completions
if (( ! $+functions[compdef] )); then
    autoload -Uz compinit
    compinit
fi

_omlx_up() {
    _arguments \
        '(-p --port)'{-p,--port}'[Port to bind (default: 11436)]:port:' \
        '(-m --model-dir)'{-m,--model-dir}'[Model directory]:model directory:_directories' \
        '(-h --help)'{-h,--help}'[Show help]'
}

_omlx_down() {
    _message -r 'Stop oMLX inference server'
}

_omlx_status() {
    _message -r 'Check oMLX server status'
}

compdef _omlx_up omlx-up
compdef _omlx_down omlx-down
compdef _omlx_status omlx-status
{{ end -}}
